---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout title="Resume" active="resume">
  <header class="page-header">
    <h1 class="display">Resume</h1>
  </header>
  <iframe
    class="resume-frame"
    src={site.resumeEmbedUrl}
    title="Jacob Yablonski resume"
    width="100%"
    height="1100"
    allow="autoplay"></iframe>
</BaseLayout>

<style>
  .page-header {
    margin-bottom: 1.5rem;
  }

  .resume-frame {
    border: 1px solid var(--rule);
    border-radius: 2px;
    display: block;
    min-height: 1100px;
    width: 100%;
  }
</style>
