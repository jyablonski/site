---
import Analytics from "../components/Analytics.astro";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import { site } from "../data/site";
import type { ActiveRoute } from "../lib/nav";
import { formatSitePageTitle } from "../lib/post-seo";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  active: ActiveRoute;
  canonicalPath?: string;
  ogType?: "website" | "article";
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description = site.description,
  active,
  canonicalPath,
  ogType = "website",
  jsonLd,
} = Astro.props;
const pageTitle = formatSitePageTitle(title);
const siteOrigin = Astro.site ?? site.url;
const canonicalUrl = new URL(canonicalPath ?? Astro.url.pathname, siteOrigin)
  .href;
const showAnalytics = import.meta.env.PROD && Boolean(site.gaId);
const jsonLdPayload = jsonLd ? JSON.stringify(jsonLd) : undefined;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="author" content={site.name} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.name}
      href="/rss.xml"
    />
    <title>{pageTitle}</title>
    {
      jsonLdPayload && (
        <script type="application/ld+json" is:inline set:html={jsonLdPayload} />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Nav active={active} />
    <main id="main-content" class="reading-column">
      <slot />
    </main>
    <Footer />
    {showAnalytics && <Analytics />}
  </body>
</html>
