---
import type { MarkdownHeading } from "astro";
import ArticleShell from "../components/ArticleShell.astro";
import Mermaid from "../components/Mermaid.astro";
import BaseLayout from "./BaseLayout.astro";
import { site } from "../data/site";
import {
  buildArticleJsonLd,
  getPostDocumentTitle,
  shouldShowUpdatedDate,
} from "../lib/post-seo";
import { formatPostDate, getPostHref } from "../lib/posts";
import type { PostEntry } from "../lib/posts";

interface Props {
  post: PostEntry;
  prev?: PostEntry;
  next?: PostEntry;
  headings?: MarkdownHeading[];
}

const { post, prev, next, headings = [] } = Astro.props;
const siteOrigin = Astro.site ?? site.url;
const canonicalPath = getPostHref(post);
const canonicalUrl = new URL(canonicalPath, siteOrigin).href;
const documentTitle = getPostDocumentTitle(post);
const showUpdated = shouldShowUpdatedDate(post);
---

<BaseLayout
  title={documentTitle}
  description={post.excerpt}
  active="posts"
  canonicalPath={canonicalPath}
  ogType="article"
  jsonLd={buildArticleJsonLd(post, canonicalUrl)}
>
  <ArticleShell headings={headings}>
    <Fragment slot="masthead">
      <p class="post-meta-row meta">
        <time datetime={formatPostDate(post.date)}>
          Published {formatPostDate(post.date)}
        </time>
        {
          showUpdated && post.updated && (
            <>
              <span aria-hidden="true"> · </span>
              <time datetime={formatPostDate(post.updated)}>
                Updated {formatPostDate(post.updated)}
              </time>
            </>
          )
        }
        <span aria-hidden="true"> · </span>
        <span>{post.readTime}</span>
      </p>
      <h1 class="display masthead-title">{post.title}</h1>
      {
        post.tags.length > 0 && (
          <div class="util-row">
            <div class="tag-row">
              {post.tags.map((tag) => (
                <span class="chip">{tag}</span>
              ))}
            </div>
          </div>
        )
      }
    </Fragment>
    <div class="prose">
      <slot />
    </div>
    <Mermaid />
    {
      (prev || next) && (
        <nav class="post-nav" aria-label="Post pagination">
          <hr class="hairline" />
          <div class="post-nav-inner">
            {prev ? (
              <a class="post-nav-link" href={getPostHref(prev)}>
                ← {prev.title}
              </a>
            ) : (
              <span />
            )}
            {next ? (
              <a class="post-nav-link post-nav-next" href={getPostHref(next)}>
                {next.title} →
              </a>
            ) : (
              <span />
            )}
          </div>
        </nav>
      )
    }
  </ArticleShell>
</BaseLayout>

<style>
  .post-meta-row {
    margin: 0 0 1rem;
  }

  .post-nav {
    margin-top: 2rem;
  }

  .post-nav-inner {
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    margin-top: 1.25rem;
  }

  .post-nav-link {
    color: var(--text-dim);
    font-size: var(--size-meta);
    max-width: 45%;
    text-decoration: none;
  }

  .post-nav-link:hover {
    color: var(--text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .post-nav-next {
    margin-left: auto;
    text-align: right;
  }
</style>
